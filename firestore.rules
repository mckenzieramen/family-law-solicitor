rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole(role) {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profile) && get(profile).data.role == role;
    }

    function isActiveAdmin() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return hasRole('admin') && get(profile).data.get('Active', false) == true;
    }

    function isSolicitor() {
      return request.auth != null
        && (request.auth.token.get('role', '') == 'solicitor' || hasRole('solicitor'));
    }

    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if isSolicitor()
        && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['role', 'lawyerUid'])
        && request.resource.data.role == 'employee'
        && request.resource.data.lawyerUid == request.auth.uid;
    }

    function ownsChecklist(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && (isSolicitor() || isActiveAdmin() || hasRole('employee'));
    }

    function validChecklist() {
      return request.resource.data.keys().hasOnly(['progress', 'updatedAt'])
        && request.resource.data.keys().hasAll(['progress', 'updatedAt'])
        && request.resource.data.progress is map
        && request.resource.data.progress.keys().hasOnly([
          'legal-0', 'legal-1', 'legal-2', 'legal-3',
          'family-0', 'family-1', 'family-2', 'family-3',
          'admin-0', 'admin-1', 'admin-2', 'admin-3', 'admin-4'
        ])
        && request.resource.data.progress.values().hasOnly([true, false])
        && request.resource.data.updatedAt == request.time;
    }

    match /staffWorkspaces/{uid}/items/{itemId} {
      allow get, list, delete: if ownsChecklist(uid);
      allow create, update: if ownsChecklist(uid) && validWorkItem();
    }

    function validWorkItem() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'title', 'notes', 'matter', 'date', 'priority', 'done', 'recipient', 'updatedAt', 'calendar', 'time', 'followUpStatus'])
        && d.keys().hasAll(['kind', 'title', 'notes', 'matter', 'date', 'priority', 'done', 'recipient', 'updatedAt'])
        && d.kind in ['Task', 'Appointment', 'Email draft']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.notes is string && d.notes.size() <= 8000
        && d.matter is string && d.matter.size() <= 80
        && d.date is string && (d.date == '' || d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && d.priority in ['Urgent', 'High', 'Normal', 'Low']
        && d.done is bool
        && d.recipient is string && d.recipient.size() <= 254
        && d.get('calendar', 'admin') in ['admin', 'client']
        && d.get('time', '') is string && d.get('time', '').matches('(([01][0-9]|2[0-3]):[0-5][0-9])?')
        && d.get('followUpStatus', '') in ['', 'client', 'solicitor', 'review']
        && (d.get('followUpStatus', '') == '' || d.kind == 'Task')
        && d.updatedAt == request.time;
    }

    function inboxStaff() {
      return request.auth != null && (isSolicitor() || isActiveAdmin());
    }

    function validContact(c) {
      return c is map
        && c.keys().hasAll(['firstName', 'lastName', 'email', 'phone', 'postcode', 'topic', 'newClient', 'preferredTime'])
        && c.keys().hasOnly(['firstName', 'lastName', 'email', 'phone', 'postcode', 'topic', 'newClient', 'preferredTime'])
        && c.firstName is string && c.firstName.size() > 0 && c.firstName.size() <= 70
        && c.lastName is string && c.lastName.size() > 0 && c.lastName.size() <= 70
        && c.email is string && c.email.size() <= 254 && c.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && c.phone is string && c.phone.size() <= 25
        && c.postcode is string && c.postcode.matches('([0-9]{4})?')
        && c.topic in ['separation', 'parenting', 'property', 'consent']
        && c.newClient in ['Yes', 'No']
        && c.preferredTime is string && c.preferredTime.size() <= 24;
    }

    match /clientInbox/{messageId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasAll(['kind', 'ownerUid', 'message', 'contact', 'createdAt', 'reply'])
        && request.resource.data.keys().hasOnly(['kind', 'ownerUid', 'message', 'contact', 'createdAt', 'reply'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.reply == ''
        && request.resource.data.message is string && request.resource.data.message.size() > 0
        && ((request.resource.data.kind == 'consultation'
          && request.resource.data.message.size() <= 1500 && validContact(request.resource.data.contact))
          || (request.resource.data.kind == 'support'
          && request.resource.data.message.size() <= 600 && request.resource.data.contact == {}));
      allow get: if inboxStaff() || (request.auth != null && resource.data.kind == 'support'
        && resource.data.ownerUid == request.auth.uid);
      allow list: if inboxStaff() && request.query.limit <= 100;
      allow update: if inboxStaff() && (
        (resource.data.kind == 'support'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply'])
          && request.resource.data.reply is string
          && request.resource.data.reply.size() > 0
          && request.resource.data.reply.size() <= 1000)
        || (resource.data.kind == 'consultation'
          && resource.data.get('approvalStatus', 'pending') == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'approvalStatus', 'approvalUpdatedAt', 'approvalUpdatedBy'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll([
            'approvalStatus', 'approvalUpdatedAt', 'approvalUpdatedBy'
          ])
          && request.resource.data.approvalStatus in ['approved', 'declined']
          && request.resource.data.approvalUpdatedAt == request.time
          && request.resource.data.approvalUpdatedBy == request.auth.uid)
      );
    }

    match /solicitorChecklists/{uid} {
      allow get: if ownsChecklist(uid);
      allow create, update: if ownsChecklist(uid) && validChecklist();
    }
  }
}
