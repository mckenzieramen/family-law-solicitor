rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasRole(role) {
      return signedIn()
        && (request.auth.token.get('role', '') == role
          || (exists(profilePath(request.auth.uid))
            && get(profilePath(request.auth.uid)).data.get('role', '') == role));
    }

    function isSolicitor() {
      return hasRole('solicitor');
    }

    function isActiveAdmin() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.get('role', '') == 'admin'
        && get(profilePath(request.auth.uid)).data.get('Active', false) == true;
    }

    function isEmployee() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.get('role', '') == 'employee';
    }

    function isFirmStaff() {
      return isSolicitor() || isActiveAdmin() || isEmployee();
    }

    function belongsToFirm(firmUid) {
      return signedIn()
        && ((isSolicitor() && request.auth.uid == firmUid)
          || (exists(profilePath(request.auth.uid))
            && ((get(profilePath(request.auth.uid)).data.get('role', '') == 'employee'
                && get(profilePath(request.auth.uid)).data.get('lawyerUid', '') == firmUid)
              || (get(profilePath(request.auth.uid)).data.get('role', '') == 'admin'
                && get(profilePath(request.auth.uid)).data.get('Active', false) == true
                && get(profilePath(request.auth.uid)).data.get('lawyerUid', request.auth.uid) == firmUid))));
    }

    function managesFirm(firmUid) {
      return (isSolicitor() && request.auth.uid == firmUid)
        || (isActiveAdmin()
          && get(profilePath(request.auth.uid)).data.get('lawyerUid', request.auth.uid) == firmUid);
    }

    function managesEmployeeAccount(uid, firmUid) {
      return signedIn() && uid != request.auth.uid
        && ((isSolicitor() && request.auth.uid == firmUid)
          || (isActiveAdmin()
            && get(profilePath(request.auth.uid)).data.get('lawyerUid', request.auth.uid) == firmUid));
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if request.resource.data.keys().hasOnly(['role', 'lawyerUid'])
        && request.resource.data.keys().hasAll(['role', 'lawyerUid'])
        && request.resource.data.role == 'employee'
        && managesEmployeeAccount(uid, request.resource.data.lawyerUid);
      allow update: if request.resource.data.keys().hasAll(['role', 'lawyerUid'])
        && request.resource.data.role == 'employee'
        && managesEmployeeAccount(uid, request.resource.data.lawyerUid)
        && resource.data.get('role', '') in ['', 'employee']
        && resource.data.get('lawyerUid', '') in ['', request.resource.data.lawyerUid]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'lawyerUid']);
      allow delete: if false;
    }

    function ownsChecklist(uid) {
      return signedIn()
        && request.auth.uid == uid
        && isFirmStaff();
    }

    function validChecklist() {
      return request.resource.data.keys().hasOnly(['progress', 'updatedAt'])
        && request.resource.data.keys().hasAll(['progress', 'updatedAt'])
        && request.resource.data.progress is map
        && request.resource.data.progress.keys().hasOnly([
          'legal-0', 'legal-1', 'legal-2', 'legal-3',
          'family-0', 'family-1', 'family-2', 'family-3',
          'admin-0', 'admin-1', 'admin-2', 'admin-3', 'admin-4'
        ])
        && request.resource.data.progress.values().hasOnly([true, false])
        && request.resource.data.updatedAt == request.time;
    }

    function validWorkItem() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'kind', 'title', 'notes', 'matter', 'date', 'priority', 'done',
          'recipient', 'updatedAt', 'calendar', 'time', 'followUpStatus',
          'assignedTo', 'linkedType', 'taskCategory', 'checklist', 'taskStatus', 'endTime', 'eventType', 'requireAttachment', 'requireApproval', 'attachmentInstructions'
        ])
        && d.keys().hasAll([
          'kind', 'title', 'notes', 'matter', 'date', 'priority',
          'done', 'recipient', 'updatedAt'
        ])
        && d.kind in ['Task', 'Appointment', 'Email draft']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.notes is string && d.notes.size() <= 8000
        && d.matter is string && d.matter.size() <= 80
        && d.date is string
        && (d.date == '' || d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && d.priority in ['Urgent', 'High', 'Normal', 'Low']
        && d.done is bool
        && d.recipient is string && d.recipient.size() <= 254
        && d.get('calendar', 'admin') in ['admin', 'client']
        && d.get('time', '') is string
        && d.get('time', '').matches('(([01][0-9]|2[0-3]):[0-5][0-9])?')
        && d.get('followUpStatus', '') in ['', 'client', 'solicitor', 'review']
        && (d.get('followUpStatus', '') == '' || d.kind == 'Task')
        && d.get('assignedTo', '') is string && d.get('assignedTo', '').size() <= 100
        && d.get('linkedType', '') in ['', 'Matter', 'Client enquiry', 'Client & Contact', 'General task']
        && d.get('taskCategory', '') in ['', 'Document preparation', 'Client follow-up', 'Legal research', 'Court preparation', 'Administrative', 'Other']
        && d.get('checklist', {}) is map && d.get('checklist', {}).size() <= 100
        && d.get('attachmentInstructions', '') is string && d.get('attachmentInstructions', '').size() <= 2000
        && d.get('requireAttachment', false) is bool
        && d.get('requireApproval', false) is bool
        && (!d.get('requireAttachment', false) || d.get('requireApproval', false))
        && d.get('taskStatus', '') in ['', 'Open', 'In Progress', 'Completed']
        && d.get('endTime', '') is string && d.get('endTime', '').matches('(([01][0-9]|2[0-3]):[0-5][0-9])?')
        && d.get('eventType', '') is string && d.get('eventType', '').size() <= 80
        && d.updatedAt == request.time;
    }

    match /staffWorkspaces/{uid}/items/{itemId} {
      allow get, list: if ownsChecklist(uid);
      allow create: if ownsChecklist(uid) && validWorkItem();
      allow update: if ownsChecklist(uid) && validWorkItem();
      allow delete: if ownsChecklist(uid);
    }

    match /staffWorkspaces/{uid}/items/{itemId}/attachments/{attachmentId} {
      allow read: if ownsChecklist(uid);
      allow create: if ownsChecklist(uid)
        && exists(/databases/$(database)/documents/staffWorkspaces/$(uid)/items/$(itemId))
        && request.resource.data.keys().hasOnly(['name','mime','bytes','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 255
        && request.resource.data.mime is string
        && request.resource.data.mime.size() <= 200
        && request.resource.data.bytes is bytes
        && request.resource.data.bytes.size() <= 716800
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    function inboxStaff() {
      return signedIn() && (isSolicitor() || isActiveAdmin());
    }

    function validContact(c) {
      return c is map
        && c.keys().hasAll([
          'firstName', 'lastName', 'email', 'phone', 'postcode',
          'topic', 'newClient', 'preferredTime'
        ])
        && c.keys().hasOnly([
          'firstName', 'lastName', 'email', 'phone', 'postcode',
          'topic', 'newClient', 'preferredTime'
        ])
        && c.firstName is string && c.firstName.size() > 0 && c.firstName.size() <= 70
        && c.lastName is string && c.lastName.size() > 0 && c.lastName.size() <= 70
        && c.email is string && c.email.size() <= 254
        && c.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && c.phone is string && c.phone.size() <= 25
        && c.postcode is string && c.postcode.matches('([0-9]{4})?')
        && c.topic in ['separation', 'parenting', 'property', 'financial', 'consent', 'maintenance', 'violence', 'mediation', 'other']
        && c.newClient in ['Yes', 'No']
        && c.preferredTime is string && c.preferredTime.size() <= 24;
    }

    match /clientInbox/{messageId} {
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasAll([
          'kind', 'ownerUid', 'message', 'contact', 'createdAt', 'reply'
        ])
        && request.resource.data.keys().hasOnly([
          'kind', 'ownerUid', 'message', 'contact', 'createdAt', 'reply'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.reply == ''
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && ((request.resource.data.kind == 'consultation'
          && request.resource.data.message.size() <= 1500
          && validContact(request.resource.data.contact))
          || (request.resource.data.kind == 'support'
          && request.resource.data.message.size() <= 600
          && request.resource.data.contact == {}));

      allow get: if inboxStaff()
        || (signedIn() && resource.data.kind == 'support'
          && resource.data.ownerUid == request.auth.uid);
      allow list: if inboxStaff() && request.query.limit <= 100;

      allow update: if inboxStaff() && (
        (resource.data.kind == 'support'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply'])
          && request.resource.data.reply is string
          && request.resource.data.reply.size() > 0
          && request.resource.data.reply.size() <= 1000)
        || (resource.data.kind == 'consultation'
          && resource.data.get('approvalStatus', 'pending') == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'approvalStatus', 'approvalUpdatedAt', 'approvalUpdatedBy'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll([
            'approvalStatus', 'approvalUpdatedAt', 'approvalUpdatedBy'
          ])
          && request.resource.data.approvalStatus in ['approved', 'declined']
          && request.resource.data.approvalUpdatedAt == request.time
          && request.resource.data.approvalUpdatedBy == request.auth.uid)
      );
      allow delete: if false;
    }

    match /supportChats/{chatId} {
      function visitor() { return signedIn() && request.auth.uid == chatId && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
      function validChatContact() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ownerUid','name','email','phone','status','createdAt','updatedAt','closedAt','closedBy'])
          && d.keys().hasAll(['ownerUid','name','email','phone'])
          && d.ownerUid == chatId
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.email is string && d.email.size() > 0 && d.email.size() <= 254
          && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 100;
      }
      allow create: if visitor() && validChatContact();
      allow update: if (visitor() && resource.data.ownerUid == chatId && validChatContact() && resource.data.get('status','open') != 'closed' && request.resource.data.get('status', resource.data.get('status','open')) == resource.data.get('status','open')) || (inboxStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','closedAt','closedBy','updatedAt']) && request.resource.data.status == 'closed' && request.resource.data.closedAt == request.time && request.resource.data.closedBy == request.auth.uid);
      allow get: if visitor() || inboxStaff();
      allow list: if inboxStaff() && request.query.limit <= 100;
      match /internalNotes/{noteId} {
        allow read: if inboxStaff();
        allow create: if inboxStaff()
          && exists(/databases/$(database)/documents/supportChats/$(chatId))
          && request.resource.data.keys().hasOnly(['text','authorUid','createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /typing/{side} {
        allow get: if (visitor() || inboxStaff()) && side in ['visitor','staff'];
        allow create, update: if exists(/databases/$(database)/documents/supportChats/$(chatId))
          && ((visitor() && side == 'visitor') || (inboxStaff() && side == 'staff'))
          && request.resource.data.keys().hasOnly(['active','updatedAt'])
          && request.resource.data.keys().hasAll(['active','updatedAt'])
          && request.resource.data.active is bool
          && request.resource.data.updatedAt == request.time;
      }
      match /presence/{side} {
        allow get: if (visitor() || inboxStaff()) && side in ['visitor','staff'];
        allow create, update: if exists(/databases/$(database)/documents/supportChats/$(chatId)) && ((visitor() && side == 'visitor') || (inboxStaff() && side == 'staff')) && request.resource.data.keys().hasOnly(['updatedAt','activeAt']) && request.resource.data.updatedAt == request.time && request.resource.data.activeAt is timestamp && request.resource.data.activeAt <= request.time;
      }
      match /messages/{messageId} {
        allow update: if ((visitor() && resource.data.sender == 'staff') || (inboxStaff() && resource.data.sender == 'visitor')) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt','seenAt']) && (request.resource.data.get('deliveredAt',null) == resource.data.get('deliveredAt',null) || (resource.data.get('deliveredAt',null) == null && request.resource.data.deliveredAt == request.time)) && (request.resource.data.get('seenAt',null) == resource.data.get('seenAt',null) || (resource.data.get('seenAt',null) == null && request.resource.data.seenAt == request.time));
        allow read: if visitor() || inboxStaff();
        allow create: if exists(/databases/$(database)/documents/supportChats/$(chatId))
          && get(/databases/$(database)/documents/supportChats/$(chatId)).data.get('status','open') != 'closed'
          && request.resource.data.keys().hasOnly(['text','sender','createdAt','image'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          && (request.resource.data.text.size() > 0 || 'image' in request.resource.data)
          && (!('image' in request.resource.data) || (
            request.resource.data.image is map
            && request.resource.data.image.keys().hasOnly(['name','mime','bytes'])
            && request.resource.data.image.name is string
            && request.resource.data.image.name.size() <= 255
            && request.resource.data.image.mime in ['image/jpeg','image/png','image/webp']
            && request.resource.data.image.bytes is bytes
            && request.resource.data.image.bytes.size() <= 716800
            && request.resource.data.image.bytes.size() > 0
          ))
          && request.resource.data.createdAt == request.time
          && ((visitor() && request.resource.data.sender == 'visitor') || (inboxStaff() && request.resource.data.sender == 'staff'));
      }
    }

    function validFirmRecord(data, firmUid, creating) {
      return data.keys().hasOnly([
          'firmUid', 'recordType', 'payload', 'createdBy',
          'createdAt', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasAll([
          'firmUid', 'recordType', 'payload', 'createdBy',
          'createdAt', 'updatedBy', 'updatedAt'
        ])
        && data.firmUid == firmUid
        && data.recordType in [
          'matter', 'client', 'task', 'appointment', 'document',
          'invoice', 'trustTransaction', 'timeEntry', 'expense',
          'contact', 'employee', 'correspondence', 'setting'
        ]
        && data.payload is map
        && data.payload.size() <= 40
        && data.createdBy is string
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && (creating
          ? data.createdBy == request.auth.uid && data.createdAt == request.time
          : data.createdBy == resource.data.createdBy
            && data.createdAt == resource.data.createdAt
            && data.firmUid == resource.data.firmUid);
    }

    match /firmRecords/{recordId} {
      allow get: if isFirmStaff() && belongsToFirm(resource.data.firmUid);
      allow list: if isFirmStaff()
        && belongsToFirm(resource.data.firmUid)
        && request.query.limit <= 250;
      allow create: if isFirmStaff()
        && belongsToFirm(request.resource.data.firmUid)
        && validFirmRecord(request.resource.data, request.resource.data.firmUid, true);
      allow update: if isFirmStaff()
        && belongsToFirm(resource.data.firmUid)
        && validFirmRecord(request.resource.data, resource.data.firmUid, false);
      allow delete: if managesFirm(resource.data.firmUid);
    }

    match /firmRecords/{recordId}/downloadRequests/{uid} {
      function docRecord() { return get(/databases/$(database)/documents/firmRecords/$(recordId)).data; }
      function lawyer() { return isSolicitor() && request.auth.uid == docRecord().firmUid; }
      allow get: if isFirmStaff() && belongsToFirm(docRecord().firmUid) && (request.auth.uid == uid || lawyer());
      allow list: if lawyer();
      allow create: if isFirmStaff() && belongsToFirm(docRecord().firmUid) && request.auth.uid == uid && docRecord().recordType == 'document' && request.resource.data.keys().hasOnly(['status','requestedAt']) && request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time;
      allow update: if (lawyer() && resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['approved','declined']) || (isFirmStaff() && belongsToFirm(docRecord().firmUid) && request.auth.uid == uid && resource.data.status == 'declined' && request.resource.data.keys().hasOnly(['status','requestedAt']) && request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time);
      allow delete: if false;
    }

    match /firmRecords/{recordId}/previews/{previewId} {
      function parentDoc() { return get(/databases/$(database)/documents/firmRecords/$(recordId)).data; }
      allow get: if isFirmStaff() && belongsToFirm(parentDoc().firmUid) && parentDoc().recordType == 'document' && previewId == 'protected';
      allow create, update: if isSolicitor() && request.auth.uid == parentDoc().firmUid && parentDoc().recordType == 'document' && previewId == 'protected' && request.resource.data.keys().hasOnly(['kind','content']) && request.resource.data.kind in ['image','archive'] && request.resource.data.content is string && request.resource.data.content.size() <= 100000;
      allow list, delete: if false;
    }

    match /firmRecords/{recordId}/fileChunks/{chunkId} {
      function parentRecord() {
        return get(/databases/$(database)/documents/firmRecords/$(recordId)).data;
      }
      function nextRecord() {
        return getAfter(/databases/$(database)/documents/firmRecords/$(recordId)).data;
      }
      allow read: if isFirmStaff() && belongsToFirm(parentRecord().firmUid) && parentRecord().payload.get('uploadState','') != 'pending' && ((isSolicitor() && request.auth.uid == parentRecord().firmUid) || get(/databases/$(database)/documents/firmRecords/$(recordId)/downloadRequests/$(request.auth.uid)).data.status == 'approved');
      allow create: if isFirmStaff()
        && (!exists(/databases/$(database)/documents/firmRecords/$(recordId)) || parentRecord().payload.get('uploadState', '') == 'pending')
        && belongsToFirm(nextRecord().firmUid)
        && nextRecord().createdBy == request.auth.uid
        && nextRecord().recordType == 'document'
        && nextRecord().payload.fileBackend == 'firestore'
        && request.resource.data.keys().hasOnly(['index','bytes'])
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.index < nextRecord().payload.chunkCount
        && request.resource.data.bytes is bytes
        && request.resource.data.bytes.size() <= 716800;
      allow update: if false;
      allow delete: if isFirmStaff() && belongsToFirm(parentRecord().firmUid) && parentRecord().createdBy == request.auth.uid && parentRecord().payload.get('uploadState', '') == 'pending';
    }

    match /firmSettings/{firmUid} {
      allow get: if isFirmStaff() && belongsToFirm(firmUid);
      allow list: if false;
      allow create, update: if managesFirm(firmUid)
        && request.resource.data.keys().hasOnly([
          'firmUid', 'payload', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'firmUid', 'payload', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.firmUid == firmUid
        && request.resource.data.payload is map
        && request.resource.data.payload.size() <= 40
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /solicitorChecklists/{uid} {
      allow get: if ownsChecklist(uid);
      allow create, update: if ownsChecklist(uid) && validChecklist();
      allow list, delete: if false;
    }
  }
}